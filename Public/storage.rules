rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerEmail() {
      return isSignedIn() && request.auth.token.email == "john@distinctrevelations.com";
    }

    // ===========================================================
    // LEGACY (flat, pre-multi-project) paths — kept fully working,
    // unchanged, throughout the migration. See firestore.rules for
    // the matching note; retired together in a later cutover step.
    // ===========================================================

    function isMember(biz) {
      return isSignedIn() &&
        firestore.exists(
          /databases/(default)/documents/businesses/$(biz)/users/$(request.auth.uid)
        );
    }

    function isOwnerOrMember(biz) {
      return isOwnerEmail() || isMember(biz);
    }

    // Single segment only (files/{biz}/{timestamp}_{filename}, per
    // filemanager.js) — deliberately NOT {path=**}, which would also match
    // (and grant cross-project access to) the nested project paths below,
    // since Storage rules OR together every matching block.
    match /files/{biz}/{fileName} {
      allow read: if isOwnerOrMember(biz);
      allow create: if isOwnerOrMember(biz);
      allow delete, update: if isOwnerEmail() ||
        ( isMember(biz) &&
          ( request.auth.uid == resource.metadata.ownerUid ||
            request.auth.token.email == resource.metadata.owner ) );
    }

    match /logos/{biz}/{fileName} {
      allow read: if isOwnerOrMember(biz);
      allow write, update, delete: if isOwnerEmail();
    }

    // ===========================================================
    // NEW (project-scoped) paths — files/{biz}/{proj}/... and
    // logos/{biz}/{proj}/{fileName}. Coexist with the legacy block
    // above during migration.
    // ===========================================================

    function isProjectMember(biz, proj) {
      return isSignedIn() &&
        firestore.exists(
          /databases/(default)/documents/businesses/$(biz)/projects/$(proj)/members/$(request.auth.uid)
        );
    }

    function isOwnerOrProjectMember(biz, proj) {
      return isOwnerEmail() || isProjectMember(biz, proj);
    }

    match /files/{biz}/{proj}/{path=**} {
      allow read: if isOwnerOrProjectMember(biz, proj);
      allow create: if isOwnerOrProjectMember(biz, proj);
      allow delete, update: if isOwnerEmail() ||
        ( isProjectMember(biz, proj) &&
          ( request.auth.uid == resource.metadata.ownerUid ||
            request.auth.token.email == resource.metadata.owner ) );
    }

    match /logos/{biz}/{proj}/{fileName} {
      allow read: if isOwnerOrProjectMember(biz, proj);
      allow write, update, delete: if isOwnerEmail();
    }

    ////////////////////////////////////////////////////////////////////////////
    // SAFETY FALLBACK — No access anywhere else
    ////////////////////////////////////////////////////////////////////////////

    match /{path=**} {
      allow read, write: if false;
    }

  }
}
