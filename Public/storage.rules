rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    ////////////////////////////////////////////////////////////////////////////
    // FILE MANAGER STORAGE (files/{biz}/...)
    ////////////////////////////////////////////////////////////////////////////

    match /files/{biz}/{path=**} {

      // Any authenticated user can read files belonging to the business
      allow read: if request.auth != null;

      // Any authenticated user can upload (create)
      allow write: if request.auth != null;

      // Only OWNER or uploader can update/delete a file
      allow delete, update: if request.auth != null &&
       (request.auth.token.email == "john@distinctrevelations.com" ||
        request.auth.token.email == resource.metadata.owner);
    }

    ////////////////////////////////////////////////////////////////////////////
    // HEADER LOGO STORAGE (logos/{biz}/{fileName})
    ////////////////////////////////////////////////////////////////////////////

    match /logos/{biz}/{fileName} {

      // Any authenticated user can read business logos
      allow read: if request.auth != null;

      // Only OWNER can upload/update/delete a business logo
      allow write, update, delete: if request.auth != null &&
        request.auth.token.email == "john@distinctrevelations.com";
    }

    ////////////////////////////////////////////////////////////////////////////
    // SAFETY FALLBACK — No access anywhere else
    ////////////////////////////////////////////////////////////////////////////

    match /{path=**} {
      allow read, write: if false;
    }

  }
}