# Copy this file to functions/.env (or functions/.env.<project-id> for a
# project-specific override) and fill in real values. Never commit the real
# .env file — it holds a live Twilio auth token.
#
# Get these from https://console.twilio.com (Account SID + Auth Token on the
# dashboard, phone number under Phone Numbers > Manage > Active Numbers).

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15551234567

# Real owner phone number in E.164 format (e.g. +15551234567).
OWNER_PHONE_NUMBER=+15551234567

# Anthropic API key for AI-phrased dashboard insights (generateInsightText).
# Get one at https://console.anthropic.com — never commit the real key.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Master off-switch for all text messages. Set to false while testing to avoid
# Twilio charges; anything other than "true" disables sending.
SMS_ENABLED=true

# SendGrid — Team Directory "send email" feature. Get an API key at
# https://app.sendgrid.com (Settings > API Keys); SENDGRID_FROM_EMAIL must be
# a sender identity verified in that SendGrid account.
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@yourcompany.com

# Master off-switch for the Team Directory's "send email" feature. Set to
# false while testing to avoid sending real email; anything other than
# "true" disables sending.
EMAIL_ENABLED=false
